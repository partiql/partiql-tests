      name:"upper wrong number of arguments{sql:\"upper()\"}",
      statement:"upper()",
      assert: {
        result: StaticAnalysisFail
      },
    },
    {
      name:"upper wrong number of arguments{sql:\"upper('', '')\"}",
      statement:"upper('', '')",
      assert: {
        result: StaticAnalysisFail
      },
    },
    {
      name:"upper wrong number of arguments{sql:\"upper('', 1)\"}",
      statement:"upper('', 1)",
      assert: {
        result: StaticAnalysisFail
      },
    },
  ],
]
