wrong_num_function_args::[
  lower::[
    {
      name:"lower wrong number of arguments{sql:\"lower()\"}",
      statement:"lower()",
      assert: {
        result: StaticAnalysisFail
      },
    },
    {
      name:"lower wrong number of arguments{sql:\"lower('', '')\"}",
      statement:"lower('', '')",
      assert: {
        result: StaticAnalysisFail
      },
    },
    {
      name:"lower wrong number of arguments{sql:\"lower('', 1)\"}",
      statement:"lower('', 1)",
      assert: {
        result: StaticAnalysisFail
      },
    },
  ],
]

