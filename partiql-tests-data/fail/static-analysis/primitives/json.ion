// Conformance tests for the JSON type, from the JSON type RFC, partiql/partiql-lang#107. They cover
// the rules the RFC has decided. A rule it leaves for later is a commented-out /* TODO: ... */
// placeholder, and becomes a test once it is specified.
//
// Section numbers such as §6.36 refer to SQL:2023, ISO/IEC 9075-2:2023. ID and IA numbers name a
// choice SQL:2023 leaves to the implementation.
//
// Values of type JSON are written with the $json annotation, defined in
// docs/partiql-tests-schema-proposal.md. The exact JSON text a function writes is not specified, so
// a test that gets JSON text back parses it with JSON(...) and matches the $json value, or only
// checks that the result IS STRING.
//
// Path steps are written as (JSON(...)).x. The RFC allows the parentheses to be left out, and
// json-accessor tests that form too.

'json-static-analysis'::[
  // JSON(...) takes a string (§6.40).
  {
    name: "json static analysis JSON(...) rejects an INT",
    statement: "JSON(42)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // JSON_SERIALIZE takes a value of type JSON, not a string (§6.38).
  {
    name: "json static analysis JSON_SERIALIZE rejects a STRING",
    statement: "JSON_SERIALIZE('{\"a\": 1}')",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // JSON_SCALAR takes a string, number, boolean or datetime (§6.41).
  {
    name: "json static analysis JSON_SCALAR rejects an INTERVAL",
    statement: "JSON_SCALAR(INTERVAL '1' DAY)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // JSON_SCALAR does not take a value of type JSON (§6.41).
  {
    name: "json static analysis JSON_SCALAR rejects a value of type JSON",
    statement: "JSON_SCALAR(JSON('1'))",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // A query operator takes a string or a value of type JSON (§10.14).
  {
    name: "json static analysis JSON_VALUE rejects an INT",
    statement: "JSON_VALUE(7, 'lax $')",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // is_valid_json takes a string or a value of type JSON.
  {
    name: "json static analysis is_valid_json rejects an INT",
    statement: "is_valid_json(1)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // Only JSON can be CAST to JSON. Use JSON(...) on a string (§6.13).
  {
    name: "json static analysis CAST rejects a STRING to JSON",
    statement: "CAST('{}' AS JSON)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // JSON can only be CAST to JSON. Use JSON_SERIALIZE or JSON_VALUE (§6.13).
  {
    name: "json static analysis CAST rejects JSON to STRING",
    statement: "CAST(JSON('1') AS STRING)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // If one input is JSON, every input must be JSON (§9.5).
  {
    name: "json static analysis COALESCE rejects JSON with a STRING",
    statement: "COALESCE(JSON('null'), 'none')",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // If one result is JSON, every result must be JSON (§9.5).
  {
    name: "json static analysis CASE rejects JSON with a STRING",
    statement: "CASE WHEN true THEN JSON('1') ELSE 'a' END",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // If one input is JSON, every input must be JSON (§9.5).
  {
    name: "json static analysis NULLIF rejects JSON with a STRING",
    statement: "NULLIF(JSON('1'), 'a')",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // If one input of a set operation is JSON, every input must be JSON (§9.5).
  {
    name: "json static analysis UNION ALL rejects a JSON column and a STRING column",
    statement: "SELECT JSON('1') AS a FROM <<1>> AS x UNION ALL SELECT 'a' AS a FROM <<1>> AS y",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // SUM, AVG and the other numeric aggregates do not accept JSON.
  {
    name: "json static analysis SUM rejects JSON",
    statement: "SELECT SUM(JSON('1')) AS s FROM <<1>> AS x",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // OMIT QUOTES is not allowed with RETURNING JSON (§6.35).
  {
    name: "json static analysis JSON_QUERY rejects OMIT QUOTES with RETURNING JSON",
    statement: "JSON_QUERY(JSON('{}'), 'lax $' RETURNING JSON OMIT QUOTES)",
    assert: {
      result: StaticAnalysisFail
    }
  },
  // A quotes clause cannot follow WITH ... WRAPPER (§6.35).
  {
    name: "json static analysis JSON_QUERY rejects a quotes clause after WITH WRAPPER",
    statement: "JSON_QUERY('{}', 'lax $' WITH WRAPPER KEEP QUOTES)",
    assert: {
      result: StaticAnalysisFail
    }
  }
]
